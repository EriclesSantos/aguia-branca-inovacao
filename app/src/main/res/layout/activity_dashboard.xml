<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Dashboard Executivo"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDashboardRoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ROI: 0%"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDashboardProjetosAtivos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Projetos ativos: 0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDashboardProdutividade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Produtividade média: 0%"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDashboardEconomia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Economia estimada: R$ 0,00"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDashboardIdeias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ideias: 0 cadastradas | 0 aprovadas"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
